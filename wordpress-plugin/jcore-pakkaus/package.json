{
  "name": "jcore-pakkaus",
  "version": "2.1.1",
  "description": "Optimizes uploaded videos with a self-hosted FFmpeg optimizer service.",
  "author": "J&Co Digital Oy <support@jco.fi>",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format src",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "lint:php": "composer lint",
    "check": "pnpm lint:js && pnpm lint:css && pnpm lint:php",
    "test:security": "node --test ../../tests/test_build_security.cjs",
    "i18n": "pnpm make-pot && pnpm make-mo && pnpm make-json",
    "make-pot": "wp i18n make-pot . languages/jcore-pakkaus.pot --domain=jcore-pakkaus --slug=jcore-pakkaus --exclude=vendor,node_modules,src,release,.wp",
    "make-mo": "wp i18n make-mo languages languages",
    "make-json": "pnpm dlx --package='@wp-blocks/make-pot@1.6.3' makejson build/ languages/",
    "playground": "wp-playground-cli server --blueprint=.wp/blueprint.json --mount=.:/wordpress/wp-content/plugins/jcore-pakkaus --php=8.2 --port=8883"
  },
  "devDependencies": {
    "@wordpress/api-fetch": "^7.56.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/icons": "^14.0.1",
    "@wordpress/notices": "^5.56.0",
    "@wordpress/scripts": "^36.0.0",
    "@wordpress/url": "^4.56.0",
    "@wp-playground/cli": "^3.1.56",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCO-Digital/jcore-pakkaus.git",
    "directory": "wordpress-plugin/jcore-pakkaus"
  },
  "bugs": {
    "url": "https://github.com/JCO-Digital/jcore-pakkaus/issues"
  },
  "homepage": "https://github.com/JCO-Digital/jcore-pakkaus#readme"
}
